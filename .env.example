# FlumeTV UI — copy to .env.local for local dev, or .env for Docker overrides.
#
# Local dev: npm run dev (set BASE_API_URL in .env.local when the API is not at localhost:7001)
# Docker (UI-only): docker compose pull && docker compose up -d
#   No .env required when the API is at http://localhost:7001 (default latest image).
#
# BASE_API_URL overrides apply only to tonycj7/flumetv-ui:configurable — see README.

# Listen port (default 7000)
# PORT=7000

# Browser-facing API origin (default http://localhost:7001 on latest image)
# BASE_API_URL=http://localhost:7001
