# Frontend (Next.js)
# Copy to .env for docker-compose overrides, or .env.local for local dev.
#
# Docker (UI-only): docker compose pull && docker compose up -d
# No .env required when API is at http://localhost:7001 (default latest image).
# Requires FlumeTV-API running (see sibling FlumeTV-API repo).
#
# BASE_API_URL overrides apply only to tonycj7/flumetv-ui:configurable — see README.

# Optional overrides — defaults: PORT=7000, BASE_API_URL=http://localhost:7001
# PORT=8080
# BASE_API_URL=https://api.example.com

# Optional nginx full-stack mode (see README — single host/port):
# PUBLIC_URL=http://localhost:7000
# PUBLIC_PORT=7000

# Optional: Set to true for debug logging in token-info redirect logic
# DEBUG_MODE=false
